# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Creativity: medium for generators, deterministic for judge/search
GEN_TEMPERATURE=0.5
FACT_TEMPERATURE=0.0

# Free, key-less image API
IMAGE_API_BASE=https://image.pollinations.ai/prompt
OUTPUT_DIR=./output

# Behavior
SEARCH_MAX_RESULTS=5
MIN_CONTENT_CHARS=200
REQUEST_TIMEOUT=60
